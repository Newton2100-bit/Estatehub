# Daraja uses sandbox by default. Set production only after Safaricom approval.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_STK_TRANSACTION_TYPE=CustomerPayBillOnline

# Public HTTPS URL used for asynchronous callbacks (run_mpesa_dev.sh sets this).
PUBLIC_BASE_URL=
DARAJA_CALLBACK_TOKEN=

# Leave worker payouts disabled until B2C is enabled for your Safaricom account.
DARAJA_B2C_ENABLED=false
DARAJA_B2C_SHORTCODE=
DARAJA_B2C_INITIATOR_NAME=
DARAJA_B2C_SECURITY_CREDENTIAL=
